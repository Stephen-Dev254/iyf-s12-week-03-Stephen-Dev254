/* DAY 3: HERO SECTION */
.hero {
    position: relative;
    height: 100vh; /* Full viewport height */
    background-image: url('https://placehold.co/1200x800?text=Hero+Background');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 30px;
}
.hero-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.6); /* Dark overlay for text readability */
}
.hero-content {
    position: relative;
    z-index: 1;
    color: white;
    max-width: 600px;
    padding: 20px;
}
.hero-content h1 {
    font-size: 2.25rem;
    color: white;
    margin-bottom: 15px;
}
.hero-content p {
    font-size: 1.125rem;
    margin-bottom: 20px;
    color: #e9ecef;
}
/* Responsive sizing */
@media (min-width: 768px) {
    .hero-content h1 { font-size: 3rem; }
}
/* DAY 4: FORM STYLING */
.styled-form {
    background: white;
    padding: 25px;
    border-radius: 12px;
    border: 1px solid #e9ecef;
}
.styled-form label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
    font-size: 0.875rem;
}
.styled-form input,
.styled-form textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    font-family: inherit;
    font-size: 1rem;
    margin-bottom: 18px;
    transition: all 0.3s ease;
}
/* Focus states */
.styled-form input:focus,
.styled-form textarea:focus {
    outline: none;
    border-color: #3b5bdb;
    box-shadow: 0 0 0 3px rgba(59,91,219,0.1);
}
/* Error states - :invalid */
.styled-form input:invalid:not(:placeholder-shown),
.styled-form textarea:invalid:not(:placeholder-shown) {
    border-color: #fa5252;
    background: #fff5f5;
}
/* Mobile-friendly */
@media (max-width: 600px) {
    .styled-form { padding: 15px; }
}

/* DAY 5: FOOTER DESIGN - 4 cols desktop / 2 tablet / 1 mobile */
.footer-columns {
    display: grid;
    grid-template-columns: 1fr; /* Mobile: 1 column */
    gap: 30px;
    text-align: left;
}
.footer-columns h3, .footer-columns h4 {
    color: white;
    margin-bottom: 12px;
}
.footer-columns p, .footer-columns li {
    color: #adb5bd;
    font-size: 0.875rem;
    line-height: 1.8;
}
@media (min-width: 768px) {
    .footer-columns {
        grid-template-columns: repeat(2, 1fr); /* Tablet: 2 columns */
    }
}
@media (min-width: 1024px) {
    .footer-columns {
        grid-template-columns: repeat(4, 1fr); /* Desktop: 4 columns */
    }
}
