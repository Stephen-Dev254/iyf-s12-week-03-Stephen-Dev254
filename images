/* ========== TASK 3.1: RESET & BASE ========== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Open+Sans:wght@400;500&display=swap');

:root {
    /* Task 3.3 Typography */
    --font-heading: 'Montserrat', sans-serif;
    --font-body: 'Open Sans', sans-serif;
    --font-xs: 0.75rem;
    --font-sm: 0.875rem;
    --font-base: 1rem;
    --font-lg: 1.125rem;
    --font-xl: 1.25rem;
    --font-2xl: 1.5rem;
    --font-3xl: 1.875rem;
    --font-4xl: 2.25rem;

    /* Task 3.4 Colors */
    --color-primary: #3b5bdb;
    --color-primary-dark: #2f49b5;
    --color-secondary: #ff922b;
    --color-bg: #fdf6f0;
    --color-text: #333333;
    --color-muted: #868e96;
    --color-white: #ffffff;
}

body {
    font-family: var(--font-body);
    font-size: var(--font-base);
    line-height: 1.6;
    color: var(--color-text);
    background-color: var(--color-bg);
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

h1 { font-family: var(--font-heading); font-size: var(--font-4xl); margin-bottom: 15px; }
h2 { font-family: var(--font-heading); font-size: var(--font-3xl); margin: 25px 0 12px; }
h3 { font-family: var(--font-heading); font-size: var(--font-2xl); margin: 20px 0 10px; }
small { font-size: var(--font-sm); }

img { max-width: 100%; height: auto; border-radius: 8px; }

/* ========== TASK 4.1: FLEXBOX NAV - WORKS WITH YOUR CURRENT HTML ========== */
/* This fixes your screenshot - makes nav horizontal */
header {
    display: flex;
    justify-content: space-between; /* Logo left, links right */
    align-items: center; /* Vertically centered */
    background: #222;
    padding: 15px 25px;
    border-radius: 6px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

header h1 {
    color: white;
    font-size: var(--font-2xl);
    margin: 0;
}

header nav ul {
    display: flex; /* Makes Home About Projects in a row */
    list-style: none; /* Removes bullets - fixes your screenshot */
    gap: 20px; /* Spacing between links */
    align-items: center;
}

header nav ul li a {
    color: white;
    text-decoration: none;
    font-size: var(--font-sm);
    font-weight: 500;
}

header nav ul li a:hover {
    color: var(--color-secondary);
}

/* Sections spacing */
section { margin-bottom: 30px; background: var(--color-white); padding: 20px; border-radius: 8px; }

/* Mobile - Task 4.3 */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }
    header nav ul {
        flex-direction: column;
        gap: 10px;
    }
}


/* ========== TASK 4.2: CSS GRID LAYOUT ========== */

/* Exercise 1: Photo Gallery - 3 columns */
.gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* [Image1][Image2][Image3] equal widths */
    gap: 15px; /* Consistent gap */
}
.gallery img {
    width: 100%;
    height: 200px;
    object-fit: cover; /* Fills cell */
    border-radius: 6px;
}

/* Exercise 2: Magazine Layout */
.magazine {
    display: grid;
    grid-template-columns: 200px 1fr;
    grid-template-areas:
        "header header"
        "sidebar main"
        "footer footer";
    gap: 15px;
    margin: 30px 0;
}
.mag-header { grid-area: header; background: #748ffc; padding: 20px; border-radius: 6px; color: white; }
.mag-sidebar { grid-area: sidebar; background: #ffd8a8; padding: 20px; border-radius: 6px; }
.mag-main { grid-area: main; background: white; padding: 20px; border-radius: 6px; border: 1px solid #ddd; }
.mag-footer { grid-area: footer; background: #222; color: white; padding: 20px; border-radius: 6px; }

/* Exercise 3: Project Cards Grid - Responsive */
.projects-grid {
    display: grid;
    grid-template-columns: 1fr; /* Mobile: 1 column */
    gap: 20px;
    margin-top: 20px;
}
.projects-grid .card {
    background: white;
    padding: 15px;
    border-radius: 8px;
    border: 1px solid #ddd;
}
.projects-grid .card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    margin-bottom: 10px;
}

/* Tablet - 2 columns */
@media (min-width: 768px) {
    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .gallery {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* Desktop - 3 columns */
@media (min-width: 1024px) {
    .projects-grid {
        grid-template-columns: repeat(3, 1fr);
    }
    .gallery {
        grid-template-columns: repeat(3, 1fr);
    }
}


/* ========== TASK 4.3: MOBILE-FIRST RESPONSIVE (REQUIRED BREAKPOINTS) ========== */
/* Base styles already are Mobile-First - this file started mobile */

/* Fix horizontal scroll - REQUIRED CHECK */
html, body {
    overflow-x: hidden;
    max-width: 100%;
}
* { max-width: 100%; }
img { max-width: 100%; height: auto; }

/* Mobile first - base styles (320px) - already done */
body {
    padding: 15px;
}

/* Tablet - min-width: 768px */
@media (min-width: 768px) {
    body {
        padding: 25px;
    }
    header {
        flex-direction: row; /* Horizontal menu on tablet+ */
    }
    header nav ul {
        flex-direction: row;
    }
}

/* Desktop - min-width: 1024px */
@media (min-width: 1024px) {
    body {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px;
    }
    /* Home: Hero with side image on desktop */
    main {
        display: block;
    }
    /* Contact: Form with sidebar on desktop */
    .contact-wrapper {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 30px;
    }
}

/* Large Desktop - min-width: 1280px */
@media (min-width: 1280px) {
    body {
        max-width: 1200px;
    }
    h1 { font-size: 3rem; }
}

/* Navigation Mobile Hamburger - CSS-only basic */
@media (max-width: 767px) {
    header {
        flex-direction: column;
        align-items: flex-start;
    }
    header nav ul {
        flex-direction: column;
        width: 100%;
        gap: 12px;
        margin-top: 15px;
    }
}



/* ========== TASK 4.4: POLISH & REFINEMENT ========== */

/* 1. Hover States */
.button, button, .card, a {
    transition: all 0.3s ease;
}

header nav ul li a:hover {
    color: var(--color-secondary);
    transform: translateY(-1px);
}

.card:hover {
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    transform: translateY(-3px);
}

button:hover, .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    background: var(--color-primary-dark);
}

a:hover {
    color: var(--color-primary);
}

/* 2. Transitions - all interactive elements smooth */
a, button, .card, header nav ul li a {
    transition: all 0.3s ease;
}

/* 3. Focus States - Accessibility REQUIRED */
a:focus, button:focus, input:focus, textarea:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}

/* 4. Final Checklist Fixes */
/* Consistent spacing */
section, .card, .gallery, .projects-grid, .magazine {
    margin-bottom: 20px;
}

/* Daily Challenges - Button Styles */
.btn-primary {
    background: var(--color-primary);
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}
.btn-secondary {
    background: transparent;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
}
.btn-danger {
    background: #fa5252;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}
.btn-disabled {
    background: #dee2e6;
    color: #868e96;
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    cursor: not-allowed;
}

/* Form Styling - Day 4 Challenge */
input, textarea, select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: var(--font-base);
    margin-bottom: 15px;
}
input:focus, textarea:focus {
    border-color: var(--color-primary);
}
input:invalid {
    border-color: #fa5252;
}

/* Footer - Day 5 Challenge - Multi-column */
footer {
    margin-top: 40px;
    padding: 20px;
    background: #222;
    color: white;
    border-radius: 6px;
}
.footer-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
}
@media (min-width: 768px) {
    .footer-columns { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
    .footer-columns { grid-template-columns: repeat(4, 1fr); }
}

